# Runtime environment. Copy this file to .env and adjust values per deployment.
OMNITRACK_ENVIRONMENT=development
OMNITRACK_API_HOST=0.0.0.0
OMNITRACK_API_PORT=8000
OMNITRACK_API_WORKERS=1
OMNITRACK_FRONTEND_PORT=8080
OMNITRACK_FRONTEND_DEV_PORT=5173
OMNITRACK_BACKEND_HOST=backend
OMNITRACK_LOCAL_API_HOST=127.0.0.1

# Omit OMNITRACK_SQLITE_PATH to use the environment default: inference_data.db
# locally and /app/data/inference_data.db in Docker Compose.
# OMNITRACK_SQLITE_PATH=inference_data.db
OMNITRACK_MODEL_PATH=yolov8n.pt
OMNITRACK_INFERENCE_DEVICE=cpu
# Inference backend: torch (default) | onnx | openvino | tensorrt | auto. auto
# picks the fastest available (tensorrt on NVIDIA CUDA -> openvino on supported
# Intel CPUs -> onnx -> torch) and falls back gracefully. openvino/onnx/tensorrt
# require their optional runtime installed.
# OMNITRACK_INFERENCE_PROVIDER=torch
# Auto mode only: benchmark available providers once at first stream start and
# select the fastest, caching results next to the model. Disabled by default so
# startup stays lazy (auto uses the fixed priority order instead).
# OMNITRACK_INFERENCE_BENCHMARK_ENABLED=false
# OMNITRACK_INFERENCE_BENCHMARK_RUNS=5
# Central inference scheduler (opt-in). When enabled, capture and inference are
# decoupled through a bounded shared worker pool so one slow stream cannot block
# others; each stream is pinned to a single worker to preserve per-stream frame
# ordering. Disabled by default (one inference thread per stream, unchanged).
# OMNITRACK_SCHEDULER_ENABLED=false
# OMNITRACK_SCHEDULER_WORKERS=2
# OMNITRACK_SCHEDULER_STREAM_QUEUE_CAPACITY=2
OMNITRACK_INFERENCE_SOURCE_RETRY_ATTEMPTS=3
OMNITRACK_INFERENCE_SOURCE_RETRY_DELAY_SECONDS=5
OMNITRACK_INFERENCE_STREAM_TIMEOUT_SECONDS=10
OMNITRACK_INFERENCE_BACKOFF_INITIAL_SECONDS=1
OMNITRACK_INFERENCE_BACKOFF_MAX_SECONDS=30
OMNITRACK_INFERENCE_BACKOFF_FACTOR=2
OMNITRACK_STREAM_STOP_TIMEOUT_SECONDS=5
OMNITRACK_FRAME_QUEUE_CAPACITY=30
OMNITRACK_FRAME_WS_POLL_TIMEOUT_SECONDS=1
OMNITRACK_EVENT_BUFFER_CAPACITY=1000
OMNITRACK_EVENT_WS_QUEUE_CAPACITY=100

OMNITRACK_LOGGING_LEVEL=INFO
OMNITRACK_CORS_ORIGINS=*
# OMNITRACK_API_KEY=

# Reserved validated connection settings for future persistence/cache/event-bus
# subsystems. They are not used by this Compose topology.
# OMNITRACK_POSTGRES_URL=
# OMNITRACK_REDIS_URL=
# OMNITRACK_KAFKA_BOOTSTRAP_SERVERS=

OMNITRACK_HEALTHCHECK_INTERVAL_SECONDS=30
OMNITRACK_HEALTHCHECK_TIMEOUT_SECONDS=5
OMNITRACK_HEALTHCHECK_START_PERIOD_SECONDS=20
OMNITRACK_HEALTHCHECK_RETRIES=3
OMNITRACK_CONTAINER_STOP_GRACE_PERIOD_SECONDS=15

# Vite build-time values. /api and /ws are routed by the Compose frontend.
VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=/ws
# VITE_API_KEY=
