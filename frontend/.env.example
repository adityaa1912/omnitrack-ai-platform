# Base URL for the FastAPI backend REST API.
# In local dev the Vite proxy maps /api -> http://localhost:8000, so this
# can stay as /api. In production set it to the deployed backend origin.
VITE_API_BASE_URL=/api

# Base URL for WebSocket connections (stream frame streaming).
# Local dev proxies /ws -> ws://localhost:8000.
VITE_WS_BASE_URL=/ws
